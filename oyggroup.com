PORT=3000
# URL pública de tu web (sin barra final), ej: https://www.oygroup.com
BASE_URL=http://localhost:3000
# Clave del panel /admin.html
ADMIN_PASSWORD=12345luchito  # (el servidor ya usa esta clave fija)
# Servidor de videollamadas. meet.jit.si es gratis; para embeber sin límites usa un Jitsi propio o JaaS (8x8.vc)
JITSI_DOMAIN=meet.jit.si
# Correo (opcional pero recomendado): avisos de contacto y reuniones
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=miguel88747@gmail.com
# WhatsApp y Gmail se configuran desde /admin.html (Conexiones). Estas variables son opcionales:
# Opción A (gratis, la más simple): CallMeBot. Desde ese WhatsApp envía "I allow callmebot to send me messages" al +34 644 51 95 23 y pega aquí la clave que te responde.
CALLMEBOT_KEY=
# Opción B (oficial): WhatsApp Cloud API de Meta
WA_TOKEN=
WA_PHONE_ID=

