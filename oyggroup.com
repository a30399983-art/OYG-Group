# O&G Group — sitio web + backend

Incluye: sitio en verde (fondo con tu imagen), cinta de clientes, brochures, formulario, chat en vivo, reuniones virtuales (Jitsi) y panel `/admin.html`.

Incluye también: sección **Nuestros proyectos** (10 proyectos), **Nuestros asesores** (4 con foto) y **redes sociales** (Facebook, Instagram, LinkedIn, TikTok y YouTube). Los enlaces de las redes se pegan en `/admin.html` → **Redes sociales**; las que queden vacías no se muestran. Las fotos de asesores están en `public/img/asesores/` (para cambiar una, reemplaza el .jpg con el mismo nombre).

## Instalar
1. Instala Node.js 18 o superior.
2. En esta carpeta: `npm install`
3. Copia `.env.example` a `.env` y completa: `ADMIN_PASSWORD` (la clave del panel es fija: 12345luchito), `BASE_URL` (tu dominio con https), y los datos SMTP si quieres recibir avisos por correo (en Gmail usa una "contraseña de aplicación").
4. Inicia: `npm start` → abre http://localhost:3000

## Panel de administración
`/admin.html` con la clave `12345luchito`: edita las 2 empresas (nombre, sitio web, servicios y brochure PDF), teléfono/correo/WhatsApp, lee mensajes y reuniones, y responde el chat en vivo (deja la pestaña abierta para que los visitantes vean que hay alguien en línea).

## Contacto único: 961746606 y miguel88747@gmail.com
Todo llega a ese WhatsApp y a ese Gmail: formulario, chat en vivo y reuniones (al agendar y cuando alguien entra a la sala). Se activa UNA sola vez desde el panel, sin tocar archivos:

1. Entra a `/admin.html` (clave `12345luchito`) y ve a **Conexiones: WhatsApp y correo**.
2. **WhatsApp (gratis, CallMeBot):** desde el WhatsApp 961746606 envía el texto `I allow callmebot to send me messages` al +34 644 51 95 23. Te responde una clave; pégala en "Clave de CallMeBot" y pulsa **Enviar mensaje de prueba**.
3. **Gmail:** en tu cuenta de Google crea una "contraseña de aplicación" (Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones), pégala en el panel y pulsa **Enviar correo de prueba**.

Si una prueba falla, el panel muestra el motivo. Las respuestas del chat en vivo se escriben en `/admin.html` (el WhatsApp con CallMeBot solo recibe avisos, no permite contestar desde ahí al chat).

## Publicar en tu web
- Necesitas un servidor con Node (VPS, Render, Railway, etc.). Hosting solo PHP/WordPress no sirve.
- Usa HTTPS: la cámara y el micrófono de las reuniones lo exigen.
- En VPS: `npm i -g pm2 && pm2 start server.js --name og-group`; con Nginx activa WebSockets (`Upgrade` y `Connection`) para el chat.
- Respalda la carpeta `data/` (mensajes, reuniones, configuración) y `uploads/` (PDF subidos).

## Reuniones
"Agendar reunión virtual" crea una sala `/meet/<código>` y envía el enlace por correo; "Reunión ahora" entra directo. Con `meet.jit.si` la sala embebida puede tener límites de tiempo; el botón "Abrir sala directa" abre la sala sin embeber. Para embeber sin límites, cambia `JITSI_DOMAIN` por tu Jitsi propio o JaaS (8x8.vc).

require("dotenv").config();
const express=require("express"),http=require("http"),path=require("path"),fs=require("fs"),crypto=require("crypto");
const multer=require("multer"),nodemailer=require("nodemailer"),{Server}=require("socket.io");
const E=process.env,PORT=E.PORT||3000,BASE=(E.BASE_URL||`http://localhost:${PORT}`).replace(/\/$/,""),JITSI=E.JITSI_DOMAIN||"meet.jit.si";
const ADMIN_PASS="12345luchito"; // clave fija del panel /admin.html (ignora cualquier ADMIN_PASSWORD viejo del .env)
const app=express(),srv=http.createServer(app),io=new Server(srv),DB=path.join(__dirname,"data","db.json"),UP=path.join(__dirname,"uploads");
fs.mkdirSync(UP,{recursive:true});fs.mkdirSync(path.dirname(DB),{recursive:true});
const def={config:{tel:"961746606",mail:E.MAIL_TO||"miguel88747@gmail.com",wa:"51961746606",co:[
 {n:"O&G SAC",d:"Ingeniería geotecnia y estructuras",u:"",pdf:"/brochures/oyg.pdf",s:["Geotecnia, geofísica y sismicidad","Diseño estructural y reforzamiento","Topografía con estaciones totales y drones","Supervisión de obras civiles y mineras"]},
 {n:"GIAR Servicios y Tecnología",d:"Consultoría en data de ingeniería",u:"",pdf:"/brochures/giar.pdf",s:["Topografía, geodesia y fotogrametría","Mecánica de suelos y geofísica","Ingeniería de obras mineras","Agentes con IA y dashboards en tiempo real"]}
]},messages:[],meetings:[],chats:{},secrets:{}};
let db=def;try{db=JSON.parse(fs.readFileSync(DB,"utf8"))}catch(e){save()}
// Migración: si ya había datos guardados, quita SPT Drilling y actualiza el número
if(Array.isArray(db.config?.co)){db.config.co=db.config.co.filter(c=>!/SPT\s*Drilling/i.test(c.n||"")).slice(0,2);
 if(db.config.wa==="51945545474")db.config.wa="51961746606";if(db.config.tel==="945545474")db.config.tel="961746606";save()}
db.secrets=db.secrets||{};
function nr(o){const r={};for(const k of["facebook","instagram","linkedin","tiktok","youtube"]){const v=String((o&&o[k])??((db.config&&db.config.redes)||{})[k]??"").trim();r[k]=/^https?:\/\//i.test(v)?v.slice(0,300):""}return r}
db.config.redes=nr(db.config.redes);save();
const SV=(k,ek)=>String((db.secrets&&db.secrets[k])||E[ek]||"").trim();
// Aviso automático al WhatsApp del grupo (CallMeBot o Meta Cloud API). Devuelve {ok,error}.
async function waSend(text){const to=String(db.config.wa||"").replace(/\D/g,"");if(!to)return{ok:false,error:"No hay número de WhatsApp configurado"};
 const tok=SV("waToken","WA_TOKEN"),pid=SV("waPhoneId","WA_PHONE_ID"),key=SV("callmebot","CALLMEBOT_KEY");
 try{let r;
  if(tok&&pid)r=await fetch(`https://graph.facebook.com/v20.0/${pid}/messages`,{method:"POST",headers:{Authorization:"Bearer "+tok,"Content-Type":"application/json"},body:JSON.stringify({messaging_product:"whatsapp",to,type:"text",text:{body:text.slice(0,1500)}})});
  else if(key)r=await fetch(`${E.CALLMEBOT_URL||"https://api.callmebot.com/whatsapp.php"}?phone=${encodeURIComponent("+"+to)}&text=${encodeURIComponent(text.slice(0,1500))}&apikey=${encodeURIComponent(key)}`);
  else return{ok:false,error:"Falta la clave de WhatsApp (CallMeBot) en Configuración de conexiones"};
  const body=(await r.text()).slice(0,300);
  if(!r.ok||/error|apikey is invalid|not (?:authorized|activated)/i.test(body)){console.error("wa:",r.status,body);return{ok:false,error:`WhatsApp respondió ${r.status}: ${body.replace(/<[^>]+>/g," ").trim().slice(0,160)}`}}
  return{ok:true}}catch(e){console.error("wa:",e.message);return{ok:false,error:e.message}}}
const wa=async t=>(await waSend(t)).ok;
function save(){fs.writeFileSync(DB+".tmp",JSON.stringify(db,null,1));fs.renameSync(DB+".tmp",DB)}
const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
// Correo: Gmail por defecto (usuario + contraseña de aplicación), configurable desde el panel o .env
let _tr=null,_trk="";
function getTr(){const user=SV("smtpUser","SMTP_USER")||db.config.mail,pass=SV("smtpPass","SMTP_PASS"),host=SV("smtpHost","SMTP_HOST")||"smtp.gmail.com",port=+(E.SMTP_PORT||587);
 if(!user||!pass)return null;const k=[host,port,user,pass].join("|");
 if(k!==_trk){_tr=nodemailer.createTransport({host,port,secure:port===465,auth:{user,pass}});_trk=k}return{tr:_tr,from:user}}
async function mailSend(to,subject,html,replyTo){const t=getTr();if(!t)return{ok:false,error:"Falta la contraseña de aplicación de Gmail en Configuración de conexiones"};if(!to)return{ok:false,error:"Sin destinatario"};
 try{await t.tr.sendMail({from:`"O&G Group" <${t.from}>`,to,subject,html,...(replyTo?{replyTo}:{})});return{ok:true}}catch(e){console.error("mail:",e.message);return{ok:false,error:e.message}}}
const mail=async(to,subject,html,replyTo)=>(await mailSend(to,subject,html,replyTo)).ok;
const hits=new Map();const limit=(n,ms)=>(q,r,x)=>{const k=q.ip+q.path,t=Date.now(),a=(hits.get(k)||[]).filter(v=>t-v<ms);if(a.length>=n)return r.status(429).json({error:"Demasiados intentos, espera unos minutos"});a.push(t);hits.set(k,a);x()};
const tokens=new Map(),okTok=t=>tokens.has(t)&&tokens.get(t)>Date.now();
const auth=(q,r,x)=>okTok(q.get("x-token"))?x():r.status(401).json({error:"No autorizado"});
app.set("trust proxy",1);app.use(express.json({limit:"100kb"}));
app.use("/uploads",express.static(UP));app.use(express.static(path.join(__dirname,"public")));
const pub=()=>({...db.config,jitsi:JITSI});
app.get("/api/config",(q,r)=>r.json(pub()));
app.post("/api/contact",limit(8,6e5),async(q,r)=>{const{n,e,m}=q.body||{};
 if(!n||!/^\S+@\S+\.\S+$/.test(e||"")||!m||m.length>3000)return r.status(400).json({error:"Revisa nombre, correo y mensaje"});
 db.messages.unshift({id:crypto.randomUUID(),n:String(n).slice(0,120),e,m,at:new Date().toISOString()});save();
 const [mk,w]=await Promise.all([mail(db.config.mail,"Nuevo mensaje desde O&G Group",`<p><b>${esc(n)}</b> (${esc(e)})</p><p>${esc(m).replace(/\n/g,"<br>")}</p>`,e),
  wa(`📩 Nuevo mensaje en O&G Group\nNombre: ${String(n).slice(0,120)}\nCorreo: ${e}\nMensaje: ${m}`)]);r.json({ok:true,wa:w,mail:mk})});
function room(){return"OGGroup-"+crypto.randomBytes(6).toString("hex")}
app.post("/api/meetings",limit(8,6e5),async(q,r)=>{const{n,e,when,topic}=q.body||{};
 if(!n||!/^\S+@\S+\.\S+$/.test(e||""))return r.status(400).json({error:"Nombre y correo válidos"});
 const id=room(),link=`${BASE}/meet/${id}`,x={id,n:String(n).slice(0,120),e,when:when||"",topic:String(topic||"").slice(0,300),link,at:new Date().toISOString()};
 db.meetings.unshift(x);save();
 const body=`<p>Reunión virtual O&amp;G Group${x.when?" · "+esc(x.when):""}</p><p><a href="${link}">${link}</a></p>`;
 await mail(e,"Tu reunión con O&G Group",body);await mail(db.config.mail,`Reunión agendada: ${esc(x.n)}`,body+`<p>${esc(x.topic)}</p>`);
 await wa(`📅 Reunión virtual agendada\nNombre: ${x.n}\nCorreo: ${e}\nFecha: ${x.when||"sin fecha"}\nTema: ${x.topic||"-"}\nEnlace: ${link}`);r.json({link,id})});
app.post("/api/meetings/instant",limit(20,6e5),(q,r)=>{const id=room();db.meetings.unshift({id,n:"Reunión inmediata",e:"",when:"ahora",topic:"",link:`${BASE}/meet/${id}`,at:new Date().toISOString()});save();
 wa(`🎥 Reunión inmediata creada: ${BASE}/meet/${id}`);r.json({link:`${BASE}/meet/${id}`,id})});
app.post("/api/meetings/join",limit(30,6e5),(q,r)=>{const{room:id,n}=q.body||{};const m=db.meetings.find(v=>v.id===String(id||""));
 if(!m)return r.status(404).json({error:"Sala no encontrada"});wa(`🎥 ${String(n||"Alguien").slice(0,60)} entró a la sala ${m.link}`);r.json({ok:true})});
app.get("/meet/:room",(q,r)=>r.sendFile(path.join(__dirname,"public","meet.html")));
app.post("/api/admin/login",limit(40,6e5),(q,r)=>{const a=Buffer.from(String(q.body?.password||"").trim()),b=Buffer.from(ADMIN_PASS);
 if(a.length!==b.length||!crypto.timingSafeEqual(a,b))return r.status(401).json({error:"Clave incorrecta"});
 const t=crypto.randomBytes(24).toString("hex");tokens.set(t,Date.now()+864e5);r.json({token:t})});
app.get("/api/admin/conn",auth,(q,r)=>r.json({wa:!!((SV("waToken","WA_TOKEN")&&SV("waPhoneId","WA_PHONE_ID"))||SV("callmebot","CALLMEBOT_KEY")),mail:!!(SV("smtpPass","SMTP_PASS")),smtpUser:SV("smtpUser","SMTP_USER")||db.config.mail,to:{wa:db.config.wa,mail:db.config.mail}}));
app.put("/api/admin/conn",auth,(q,r)=>{const b=q.body||{},m={callmebot:"callmebot",waToken:"waToken",waPhoneId:"waPhoneId",smtpUser:"smtpUser",smtpPass:"smtpPass"};
 for(const k in m){if(typeof b[k]!=="string")continue;const v=b[k].trim();if(!v)continue;if(v==="-")delete db.secrets[k];else db.secrets[k]=k==="smtpPass"?v.replace(/\s+/g,""):v.slice(0,400)}
 _trk="";save();r.json({ok:true})});
app.post("/api/admin/test",auth,async(q,r)=>{const k=q.body?.kind;
 if(k==="wa"){const x=await waSend("✅ Prueba de O&G Group: si lees esto, los avisos de la página llegan a este WhatsApp.");return r.json(x)}
 if(k==="mail"){const x=await mailSend(db.config.mail,"Prueba de O&G Group","<p>✅ Si lees esto, los mensajes de la página llegan a este correo.</p>");return r.json(x)}
 r.status(400).json({error:"Tipo inválido"})});
app.get("/api/admin/data",auth,(q,r)=>r.json({config:db.config,messages:db.messages,meetings:db.meetings,chats:db.chats}));
app.put("/api/admin/config",auth,(q,r)=>{const c=q.body||{};if(!Array.isArray(c.co)||c.co.length!==2)return r.status(400).json({error:"Config inválida"});
 db.config={tel:String(c.tel||""),mail:String(c.mail||""),wa:String(c.wa||""),co:c.co.map((x,i)=>({n:String(x.n||""),d:String(x.d||""),u:/^https?:\/\//.test(x.u||"")?x.u:"",pdf:db.config.co[i].pdf,s:Array.isArray(x.s)?x.s.map(String).slice(0,8):[]})),redes:nr(c.redes)};save();r.json({ok:true})});
const up=multer({storage:multer.diskStorage({destination:UP,filename:(q,f,cb)=>cb(null,`empresa${q.params.i}-${Date.now()}.pdf`)}),limits:{fileSize:25e6},fileFilter:(q,f,cb)=>cb(null,f.mimetype==="application/pdf")});
app.post("/api/admin/pdf/:i",auth,up.single("pdf"),(q,r)=>{const i=+q.params.i;if(!q.file||![0,1].includes(i))return r.status(400).json({error:"Sube un PDF (máx. 25 MB)"});
 db.config.co[i].pdf="/uploads/"+q.file.filename;save();r.json({pdf:db.config.co[i].pdf})});
// Chat en vivo
const chatMsg=(id,from,t)=>{const c=db.chats[id]||(db.chats[id]={id,msgs:[]});const m={from,t:String(t).slice(0,1000),at:new Date().toISOString()};c.msgs.push(m);c.msgs=c.msgs.slice(-200);save();return m};
io.on("connection",s=>{const a=s.handshake.auth||{};
 if(a.token){if(!okTok(a.token))return s.disconnect(true);s.join("admins");s.emit("chats",db.chats);
  s.on("reply",({id,t})=>{if(!db.chats[id]||!t)return;io.to("v:"+id).emit("msg",chatMsg(id,"a",t));io.to("admins").emit("chat",db.chats[id])});return}
 const id=String(a.vid||"").replace(/[^\w-]/g,"").slice(0,64);if(!id)return s.disconnect(true);s.join("v:"+id);
 if(!db.chats[id]){chatMsg(id,"a","¡Bienvenido a O&G Grupo! ¿En qué podemos ayudarte hoy?")}
 s.emit("history",db.chats[id].msgs);
 s.on("msg",({t})=>{if(!t||typeof t!=="string")return;const m=chatMsg(id,"v",t);s.emit("msg",m);wa(`💬 Chat en vivo (visitante ${id.slice(0,6)}): ${t.slice(0,800)}`);io.to("admins").emit("chat",db.chats[id]);
  if(!io.sockets.adapter.rooms.get("admins")){const c=db.chats[id],now=Date.now();if(!c.off||now-c.off>6e5){c.off=now;s.emit("msg",chatMsg(id,"a","Recibimos tu mensaje. Te responderemos en breve; si es urgente, llámanos al "+db.config.tel+"."))}}})});
srv.listen(PORT,()=>console.log(`O&G Group en ${BASE} (puerto ${PORT})`));
